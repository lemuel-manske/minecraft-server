#!/bin/bash
exec > /var/log/setup.log 2>&1
set -euxo pipefail

apt-get update
apt-get install -y openjdk-${java_version}-jdk wget unzip tmux

BASE="/home/ubuntu/mc"

mkdir -p "$BASE/base" "$BASE/bin" \
  "$BASE/state/world" \
  "$BASE/state/config" \
  "$BASE/state/serverconfig" \
  "$BASE/state/kubejs" \
  "$BASE/state/customnpcs" \
  "$BASE/state/ftbquests"

cd "$BASE/base"

case "${loader}" in
  forge)
    wget -O forge-installer.jar "${forge_url}"
    echo "${forge_sha256}  forge-installer.jar" | sha256sum -c -
    java -jar forge-installer.jar --installServer
    rm forge-installer.jar
    ;;
  fabric)
    wget -O fabric-installer.jar "https://maven.fabricmc.net/net/fabricmc/fabric-installer/1.1.0/fabric-installer-1.1.0.jar"
    java -jar fabric-installer.jar server -mcversion "${minecraft_version}" -loader "${fabric_loader_version}" -downloadMinecraft
    rm fabric-installer.jar
    ;;
  *)
    echo "Unsupported loader: ${loader}" >&2
    exit 1
    ;;
esac

echo "eula=true" > eula.txt
ln -sfn ../state/world "$BASE/base/world"

cat > "$BASE/bin/start.sh" <<'STARTSCRIPT'
#!/bin/bash
if ! tmux has-session -t mc 2>/dev/null; then
  if [ -f /home/ubuntu/mc/base/fabric-server-launch.jar ]; then
    tmux new-session -d -s mc "cd /home/ubuntu/mc/base && java -Xms4G -Xmx8G -jar fabric-server-launch.jar nogui"
  else
    tmux new-session -d -s mc "cd /home/ubuntu/mc/base && ./run.sh"
  fi
fi
tail -f /dev/null
STARTSCRIPT

chmod +x "$BASE/bin/start.sh"

cat > "$BASE/bin/mc-stop.sh" <<'STOPSCRIPT'
#!/bin/bash
/usr/bin/tmux send-keys -t mc "save-all" C-m
sleep 10
/usr/bin/tmux send-keys -t mc "stop" C-m
STOPSCRIPT

chmod +x "$BASE/bin/mc-stop.sh"

cat > /etc/systemd/system/minecraft.service <<'UNIT'
[Unit]
Description=Minecraft Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mc/base
ExecStart=/home/ubuntu/mc/bin/start.sh
ExecStop=/home/ubuntu/mc/bin/mc-stop.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

chown -R ubuntu:ubuntu "$BASE"

systemctl daemon-reload
systemctl enable minecraft

touch "$BASE/.setup-complete"
